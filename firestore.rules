rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check for admin email
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "mahmoud.m.moussa5310@gmail.com";
    }

    // Admins Collection: Read-only for public (if needed) or strict
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin(); // Only super admin can write
    }

    // Users Collection: User can read/write their own data, Admin can read/write all
    // Secured against self-role upgrading
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isVIP', 'disabled']));
      allow delete: if isAdmin();

      // Chat History Subcollection: User can read/write/delete their own chat history
      match /chatHistory/{messageId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- Public Content Collections ---

    // Hero Slides (The Slider)
    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tools
    match /tools/{toolId} {
      allow read: if true;
      // Allow authenticated users to update only voting and save fields
      allow update: if request.auth != null 
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['votes', 'votingStats', 'rating', 'reviewCount', 'savedBy']);
      // Allow admin full write access (covers create, update, delete)
      allow write: if isAdmin();
      
      // Votes subcollection - users can manage their own votes
      match /votes/{votingUserId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == votingUserId;
      }
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // News
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Articles (if used in Firestore)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      // Prevent user identity spoofing during creation
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Allow user to edit their own reviews without modifying the userId field
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid 
        && request.resource.data.userId == request.auth.uid;
      // Allow owner or admin to delete reviews
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Roadmap
    match /roadmap/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Changelog
    match /changelog/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Newsletter Subscriptions
    match /newsletter_subscribers/{subscriberId} {
      allow create: if true; // Public can subscribe
      allow read, delete: if isAdmin(); // Only admin can manage
    }

    // Contact Messages
    match /contact_messages/{messageId} {
      allow create: if true; // Public can send messages
      allow read, update, delete: if isAdmin(); // Only admin can read/manage
    }

    // Projects
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
